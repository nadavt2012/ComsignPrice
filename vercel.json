{
  "version": 2,
  "buildCommand": "vite build && npx esbuild api/_handler.ts --bundle --packages=external --platform=node --target=node20 --format=esm --outfile=api/index.js --tsconfig=tsconfig.json",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
